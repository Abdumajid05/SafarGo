# GEMINI_API_KEY: Not used by SafarGo.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# TELEGRAM_BOT_TOKEN MUST NOT be configured in the Android client or packaged into BuildConfig/APK.
# Telegram Bot API tokens belong exclusively on a trusted backend server
# (e.g., Firebase Cloud Functions using Google Cloud Secret Manager).
# TELEGRAM_BOT_TOKEN=SERVER_SIDE_SECRET_ONLY
